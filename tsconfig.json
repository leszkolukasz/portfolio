{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@/assets/*": ["./src/assets/*"],
      "@/components/*": ["./src/components/*"],
      "@/constants": ["./src/constants.ts"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/types": ["./src/types.ts"],
      "@/site-config": ["./src/site.config.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}

---
import Button from "@/components/Button.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { SKILLS } from "@/constants";
import PageLayout from "@/layouts/BaseLayout.astro";
import type { Project, SiteMeta } from "@/types";

const meta: SiteMeta = {
  title: "Projects",
  description: "Projects I've worked on",
};

const projects: Project[] = [
  {
    title: "MLOps Pipeline for Fraud Detection - Visa internship",
    description:
      "Scalable MLOps pipeline for a device-fingerprint fraud detection system. Includes an end-to-end training and evaluation workflow and a transformer-based model for detecting fraudulent activity across high-volume transaction streams.",
    skills: [
      SKILLS.pytorch,
      SKILLS.mlflow,
      SKILLS.ray,
      SKILLS.airflow,
      SKILLS.spark,
      SKILLS.pandas,
    ],
  },
  {
    title: "SubSHAP: Visual Feature Attribution",
    description:
      "Research project on visual Shapley values. SubSHAP is a unified image-substitution pipeline that computes n-Shapley values and achieves high-quality visual feature attribution according to the ROAR benchmark.",
    href: "https://github.com/filip123355/counterfactual-explanations-by-substitution",
    skills: [
      SKILLS.python,
      SKILLS.pytorch,
      SKILLS.opencv,
      SKILLS.mlflow,
      SKILLS.numpy,
      SKILLS.pandas,
    ],
  },
  {
    title: "GraphMLGO: Topology-Aware RL for Function Inlining",
    description:
      "Research project extending ML-guided compiler optimisation (MLGO) with richer call-graph representations. Compares application of GraphSAGE and GAT embeddings for the LLVM inlining policy.",
    href: "https://github.com/leszkolukasz/graph-mlgo",
    skills: [SKILLS.python, SKILLS.jax, SKILLS.cpp, SKILLS.huggingface, SKILLS.numpy],
  },
  {
    title: "Training 1.58bit LLMs via Distillation",
    description:
      "Research on training 1.58bit LLMs via distillation. It explores the effectiveness of distillation using different quantization methods, such as those introduces in papers: OneBit, BitNet and FBI and compares them with 1bit quantization.",
    href: "https://github.com/leszkolukasz/training-1.58bit-llms-via-distillation",
    skills: [SKILLS.python, SKILLS.pytorch, SKILLS.huggingface, SKILLS.pandas],
  },
  {
    title: "Moondream CPP - C++ library/Android app",
    description:
      "C++ header only library that provides inference for Moondream LLM (autoregressive image captioning). Contains a deskop app and Android app made in Qt to showcase the library.",
    href: "https://github.com/leszkolukasz/moondream-cpp",
    skills: [SKILLS.cpp, SKILLS.qt],
  },
  {
    title: "QUMAM - Learning Management System",
    description:
      "Platform for managing math courses and students. It offers rich UI for creating courses and exercises, as well as a student portal for tracking progress. Includes LLM capabilities like math task generation from image.",
    href: "https://qumam.edu.pl",
    skills: [
      SKILLS.typescript,
      SKILLS.react,
      SKILLS.python,
      SKILLS.django,
      SKILLS.postgresql,
      SKILLS.litellm,
      SKILLS.openai,
    ],
  },
  {
    title: "Alerting platform - highly scalable microservices system",
    description:
      "Highly scalable and fault-tolerant microservice system for processing and managing health checks for user-defined endpoints. Provides real-time alerting via multiple channels if an endpoint goes down as well as detailed analytics and reporting.",
    href: "https://github.com/zamojtel/irio-alerting-platform",
    skills: [SKILLS.go, SKILLS.gcloud, SKILLS.kubernetes, SKILLS.docker],
  },
  {
    title: "Type Safe Tensors - Haskell library",
    description:
      "Pure Haskell tensor library inspired by PyTorch. It provides type-safe N-dimensional tensors, broadcasting, neural network building blocks, and more, all with type-level shape tracking.",
    href: "https://github.com/leszkolukasz/type-safe-tensors",

    skills: [SKILLS.haskell],
  },
  {
    title: "TACACS - protocol implementation with correctness proofs",
    description:
      "Implementation of the TACACS protocol in Coq and Ocaml. According to the RFC1492.",
    href: "https://github.com/leszkolukasz/tacacs-coq",
    skills: [SKILLS.ocaml, SKILLS.rocq],
  },
  {
    title: "Kava - programming language",
    description:
      "Programming language inspired by Kotlin with elements borrowed from Java and JavaScript. It is statically typed, interpreted, and supports functions as first-class citizens.",
    href: "https://github.com/leszkolukasz/kava-programming-language",
    skills: [SKILLS.haskell],
  },
  {
    title: "Latte - programming language",
    description:
      "Imperative language, a subset of Java. It is statically typed, compiled, and supports object-oriented programming.",
    href: "https://github.com/leszkolukasz/latte-compiler",
    skills: [SKILLS.haskell, SKILLS.rust],
  },
];
---

<PageLayout meta={meta}>
  <div class="w-full">
    <Button title="Back" href="/" style="button">
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        slot="icon-before"
      >
        <path
          fill="currentColor"
          d="m6.921 12.5l5.792 5.792L12 19l-7-7l7-7l.713.708L6.921 11.5H19v1z"
        ></path>
      </svg>
    </Button>

    <div class="mt-10 flex w-full flex-col gap-y-10">
      <h1 class="mb-1 text-2xl font-bold">Projects</h1>
      <div class="flex flex-col flex-wrap justify-start gap-x-6 gap-y-6 sm:flex-row">
        {projects.map((project) => (
  <ProjectCard
    component={project.href ? "a" : "div"}
    {...(project.href ? { href: project.href } : {})}
    heading={project.title}
    subheading={project.description}
    image={project.image}
    altText={project.title}
    skills={project.skills}
    class="w-full sm:w-[calc(50%-0.75rem)]"
  />
))}
      </div>
    </div>
  </div>
</PageLayout>
